:root{
  --bg:#faf6f0; --ink:#2a211c; --muted:#6f625a;
  --wine:#5b1a24; --gold:#b8955a; --dark:#1c1512; --line:#e6dccd;
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Inter',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);color:var(--ink);background:var(--bg);line-height:1.7;font-weight:300}
h1,h2,h3,.logo{font-family:var(--serif);font-weight:600;line-height:1.1}
a{color:inherit;text-decoration:none}

/* Navegación */
.nav{position:fixed;top:0;left:0;right:0;z-index:10;display:flex;justify-content:space-between;align-items:center;
  padding:18px 5%;background:rgba(28,21,18,.85);backdrop-filter:blur(8px);color:#fff}
.logo{font-size:1.7rem}
.logo span{color:var(--gold)}
.nav nav{display:flex;align-items:center;gap:28px;font-size:.9rem;letter-spacing:.05em}
.nav nav a:hover{color:var(--gold)}

/* Botones */
.btn{display:inline-block;background:var(--gold);color:var(--dark);padding:14px 32px;border:0;border-radius:2px;
  font:500 .85rem var(--sans);letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:.25s}
.btn:hover{background:#fff}
.btn-small{padding:9px 20px}
.btn-outline{background:transparent;color:#fff;border:1px solid #fff}
.btn-outline:hover{background:#fff;color:var(--dark)}

/* Hero */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;padding:120px 5% 60px;
  background:linear-gradient(rgba(28,21,18,.62),rgba(28,21,18,.78)),
  radial-gradient(circle at 30% 20%,#7a2a36 0,#2a1410 60%,#1c1512 100%)}
.hero-content{max-width:720px}
.eyebrow{font-size:.78rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
.eyebrow.dark{color:var(--wine)}
.hero h1{font-size:clamp(3.4rem,10vw,6.5rem);margin-bottom:20px}
.lead{font-size:1.15rem;opacity:.9;margin-bottom:36px}
.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

/* Estadísticas */
.stats{display:grid;grid-template-columns:repeat(3,1fr);background:var(--wine);color:#fff;text-align:center}
.stats div{padding:34px 16px;border-right:1px solid rgba(255,255,255,.15)}
.stats div:last-child{border:0}
.stats strong{display:block;font:600 2.2rem var(--serif);color:var(--gold)}
.stats span{font-size:.85rem;opacity:.85}

/* Secciones */
.section{padding:100px 5%}
.container{max-width:1100px;margin:auto}
.narrow{max-width:640px}
.center{text-align:center}
h2{font-size:clamp(2.2rem,5vw,3.2rem);margin-bottom:20px;color:var(--wine)}
h2.light{color:#fff}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about p+p{margin-top:16px}
.about p{color:var(--muted)}

/* Carta */
.menu{background:#fff}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px;margin-top:50px}
.cards article{padding:34px 28px;border:1px solid var(--line);border-top:3px solid var(--gold);background:var(--bg)}
.cards h3{font-size:1.6rem;color:var(--wine);margin-bottom:10px}
.cards p{color:var(--muted);font-size:.95rem}
.note{text-align:center;margin-top:30px;font-size:.85rem;color:var(--muted)}

/* Opiniones */
.reviews{background:var(--dark);color:#fff}
.cards.three{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
